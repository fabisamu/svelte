# Kopiere diese Datei nach ".env" und trage deine Werte ein. Die Datei ".env" nie ins Git legen.

# Adresse, unter der die Website erreichbar ist (ohne Schrägstrich am Ende)
BASE_URL=http://localhost:3000
PORT=3000
# Im echten Betrieb: NODE_ENV=production
NODE_ENV=development
# Auf 1 setzen, wenn ein Reverse-Proxy (nginx, Caddy, Render, Fly ...) davor steht
TRUST_PROXY=

# --- KI-Assistent (Claude): Schlüssel von https://platform.claude.com ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_FREE_PER_DAY=5
AI_PREMIUM_PER_DAY=50
AI_GLOBAL_PER_DAY=2000

# --- Zahlung (Stripe): https://dashboard.stripe.com/apikeys ---
# Zum Testen den Schlüssel sk_test_... verwenden.
STRIPE_SECRET_KEY=
# Webhook auf  BASE_URL/api/stripe/webhook  anlegen und das Signaturgeheimnis (whsec_...) eintragen
STRIPE_WEBHOOK_SECRET=

# --- E-Mail (Anmeldelinks und Erinnerungen) ---
# Beispiel: smtps://benutzer:passwort@smtp.dein-anbieter.at:465
SMTP_URL=
MAIL_FROM=Nightstamp <hallo@deine-domain.at>

# --- Betreiber: erscheint in Impressum, Datenschutz und AGB ---
OPERATOR_NAME=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_UID=
OPERATOR_REGISTER=
OPERATOR_BUSINESS=Betrieb einer Online-Plattform für Veranstaltungsinformationen
OPERATOR_AUTHORITY=
OPERATOR_HOSTING=

# Zusätzliche Hochschul-Domains für den Studierendenpreis, mit Komma getrennt
STUDENT_DOMAINS=
