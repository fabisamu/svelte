{
  "name": "nightstamp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nightstamp – Clubs und Events in Österreich, mit KI-Assistent, Altersprüfung, Datenschutz und Stripe-Zahlung",
  "engines": { "node": ">=20.12" },
